# ── Base de données (fournie automatiquement par Railway / Render) ──
DATABASE_URL=postgresql://vigia:pass@localhost/vigia

# ── Administration des clés API partenaires ──
# Jeton secret pour créer/révoquer des clés via /api/v1/admin/keys
ADMIN_TOKEN=change-me-admin-secret

# ── Fournisseurs IA externes (optionnels — repli heuristique si absents) ──
# Vérif-Lien : https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_KEY=
# Vérif-Média (deepfake / IA) : https://sightengine.com
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
# Vérif-Info (désinformation) : https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── CORS : origines partenaires autorisées (séparées par des virgules) ──
# Les extensions navigateur sont déjà autorisées par défaut.
CORS_ORIGINS=

# ── Email (rapports d'analyse via /send-report) ──
# Pour le grand public, préférer un service transactionnel (Brevo, Resend, SendGrid)
# plutôt qu'un compte mutualisé (quotas faibles).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_NAME=VigIA

# ── Environnement ──
ENV=production
